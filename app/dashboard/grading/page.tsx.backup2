import { revalidatePath } from 'next/cache'
import { redirect } from 'next/navigation'
import Link from 'next/link'
import { createClient } from '@/lib/supabase/server'

const DEFAULT_LEVELS = [
  { level_code: 'EE', min_score: 80, max_score: 100, description: 'Exceeding Expectation' },
  { level_code: 'ME', min_score: 60, max_score: 79.99, description: 'Meeting Expectation' },
  { level_code: 'AE', min_score: 40, max_score: 59.99, description: 'Approaching Expectation' },
  { level_code: 'BE', min_score: 0, max_score: 39.99, description: 'Below Expectation' },
]

function readLevels(formData: FormData) {
  return Array.from({ length: 8 }, (_, index) => ({
    level_code: String(formData.get(`level_${index}`) || '').trim().toUpperCase(),
    min_score: Number(formData.get(`min_${index}`)),
    max_score: Number(formData.get(`max_${index}`)),
    description: String(formData.get(`description_${index}`) || '').trim(),
    sort_order: index,
  })).filter(r => r.level_code || r.description || Number.isFinite(r.min_score) || Number.isFinite(r.max_score))
}

async function saveGrading(formData: FormData) {
  'use server'
  const supabase = await createClient()
  const { data: { user } } = await supabase.auth.getUser()
  if (!user) redirect('/login')
  const { data: profile } = await supabase.from('profiles').select('tenant_id').eq('id', user.id).single()
  if (!profile?.tenant_id) redirect('/dashboard/grading?error=No%20school%20is%20linked%20to%20this%20account')
  const rows = readLevels(formData)
  if (rows.length < 4 || rows.length > 8) redirect('/dashboard/grading?error=Configure%204%20to%208%20grading%20levels')
  const invalid = rows.some(r =>
    !r.level_code ||
    !r.description ||
    !Number.isFinite(r.min_score) ||
    !Number.isFinite(r.max_score) ||
    r.min_score < 0 ||
    r.max_score > 100 ||
    r.min_score > r.max_score
  )

  // Validate decimal grading ranges by their numeric boundaries.
  // Column/order does not matter. Ranges are sorted by minimum score first.
  // Adjacent ranges are allowed; only an actual numeric intersection is rejected.
  const sortedRanges = [...rows].sort((a, b) => a.min_score - b.min_score)

  const overlap = sortedRanges.some((current, index) => {
    if (index === 0) return false
    const previous = sortedRanges[index - 1]

    // Allow ranges to meet at a boundary.
    // Example: 0–40 and 40–60 are considered adjacent, not overlapping.
    return current.min_score < previous.max_score
  })

  if (invalid || overlap) {
    redirect(
      `/dashboard/grading?error=${encodeURIComponent(
        overlap
          ? 'Grading ranges must not overlap'
          : 'Check all levels, ranges and descriptions'
      )}`
    )
  }
  const { data: template } = await supabase.from('report_templates').select('id').eq('tenant_id', profile.tenant_id).eq('is_default', true).maybeSingle()
  let templateId = template?.id
  if (!templateId) {
    const { data: created, error } = await supabase.from('report_templates').insert({ tenant_id: profile.tenant_id, name: 'Default Report Form', template_json: {}, is_default: true }).select('id').single()
    if (error || !created) redirect(`/dashboard/grading?error=${encodeURIComponent(error?.message || 'Could not create report template')}`)
    templateId = created.id
  }
  const { error: deleteError } = await supabase.from('report_grading_levels').delete().eq('report_template_id', templateId)
  if (deleteError) redirect(`/dashboard/grading?error=${encodeURIComponent(deleteError.message)}`)
  const { error } = await supabase.from('report_grading_levels').insert(rows.map(r => ({ ...r, tenant_id: profile.tenant_id, report_template_id: templateId })))
  if (error) redirect(`/dashboard/grading?error=${encodeURIComponent(error.message)}`)
  revalidatePath('/dashboard/grading'); revalidatePath('/dashboard/results'); revalidatePath('/dashboard/reports'); revalidatePath('/dashboard/reports/template')
  redirect('/dashboard/grading?saved=1')
}

export default async function GradingPage({ searchParams }: { searchParams: Promise<{ saved?: string; error?: string }> }) {
  const params = await searchParams
  const supabase = await createClient()
  const { data: { user } } = await supabase.auth.getUser()
  if (!user) return <main className="main"><p>Please sign in.</p></main>
  const { data: profile } = await supabase.from('profiles').select('tenant_id').eq('id', user.id).single()
  if (!profile?.tenant_id) return <main className="main"><p>No school is linked to this account.</p></main>
  const { data: template } = await supabase.from('report_templates').select('id').eq('tenant_id', profile.tenant_id).eq('is_default', true).maybeSingle()
  const { data } = template?.id ? await supabase.from('report_grading_levels').select('level_code,min_score,max_score,description,sort_order').eq('report_template_id', template.id).order('sort_order') : { data: null }
  const scale = data?.length ? data : DEFAULT_LEVELS
  return <main className="main" style={{ maxWidth: 1000, margin: '0 auto' }}><div className="top"><div><div className="eyebrow">Report template configuration</div><h1 className="title">Grading Levels</h1><p className="muted">Configure 4â€“8 levels. These ranges and labels determine the level shown on results and reports.</p></div><Link className="btn secondary" href="/dashboard/reports/template">Report template</Link></div>
    {params.error && <div className="notice error">{params.error}</div>}{params.saved && <div className="notice success">Grading levels saved.</div>}
    <form action={saveGrading} className="card"><div className="table"><div className="row header"><span>Level</span><span>Minimum</span><span>Maximum</span><span>Description</span></div>{Array.from({ length: 8 }, (_, index) => { const r: any = scale[index]; return <div className="row" key={index}><input name={`level_${index}`} defaultValue={r?.level_code ?? ''} placeholder={index < 4 ? `Level ${index + 1}` : 'Optional'} /><input name={`min_${index}`} type="number" min="0" max="100" step="0.01" defaultValue={r?.min_score ?? ''}/><input name={`max_${index}`} type="number" min="0" max="100" step="0.01" defaultValue={r?.max_score ?? ''}/><input name={`description_${index}`} defaultValue={r?.description ?? ''} placeholder={index < 4 ? 'Performance description' : 'Optional'} /></div>})}</div><p className="muted" style={{ marginTop: 12 }}>Leave rows 5â€“8 empty when using four levels. Ranges cannot overlap and must stay within 0â€“100.</p><button className="btn" style={{ marginTop: 20 }}>Save grading levels</button></form>
  </main>
}

